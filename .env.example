# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo se usa en Route Handlers (servidor). NUNCA exponerla con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dominio raíz de producción (subdominios de tenant se resuelven contra este valor en proxy.ts)
NEXT_PUBLIC_ROOT_DOMAIN=ayxco.app

# WhatsApp de soporte de BTA (no del tenant) que se muestra en app/suspended.
# Formato E.164 sin "+" ni espacios, ej. 5215512345678. Si se deja vacío no
# se muestra el botón de contacto.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Rate limits (lib/rate-limit.ts). Sin estas variables no se limita (solo desarrollo local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protege las rutas /api/cron/*. Vercel la envía como "Authorization: Bearer <valor>".
CRON_SECRET=

# Demo (T26, docs/DEMO.md): contraseña compartida de los usuarios demo.ayx.test. La misma que
# usas en `DEMO_PASSWORD=... npm run seed:demo`; /demo/entrar la usa para entrar como el editor
# de demo-broker. Mínimo 10 caracteres, solo letras, números, _ . -
DEMO_PASSWORD=

# Turnstile del registro (Cloudflare). Sin site key el formulario funciona sin captcha (solo desarrollo).
# Para que también proteja los signUp directos, activa Captcha con Turnstile en Supabase Auth con el secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare R2 (medios, T12). Crea el bucket y un API token S3 con permiso de lectura/escritura sobre él.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Dominio público (CDN) del bucket; por defecto https://media.<dominio raíz>.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Correo transaccional (T25, Resend). Sin RESEND_API_KEY no se manda nada y el resto sigue funcionando.
# El dominio de EMAIL_FROM debe estar verificado en Resend (SPF, DKIM, DMARC: docs/LAUNCH-CHECKLIST.md).
RESEND_API_KEY=
# Por defecto: "AYXCO <hola@ayxco.app>" (sale de lib/brand.ts).
EMAIL_FROM=
# Opcional: a dónde caen las respuestas.
EMAIL_REPLY_TO=
# Solo para pruebas: URL de un servidor falso que haga de Resend (por defecto, la API real).
RESEND_API_URL=

# Monitoreo (T19, docs/MONITORING.md). Sin estas variables el código sigue funcionando (Sentry no
# manda nada, /api/health/deep responde 401, los heartbeats no hacen ping) — no bloquean nada.
# DSN del proyecto en Sentry (es público por diseño: identifica el proyecto, no autentica).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Solo para que el build suba source maps a Sentry (org y project van en sentry.io → Settings).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Protege GET /api/health/deep; se manda como header "x-health-token". Cualquier valor largo y aleatorio.
HEALTH_CHECK_TOKEN=
# Llave en R2 de un archivo cualquiera que subas una vez, solo para que /api/health/deep confirme
# que el bucket responde con un HEAD real.
R2_HEALTH_KEY=health/ping.txt
# URL de heartbeat de Better Stack por cada cron (Monitors → Heartbeats); una por ruta, todas opcionales.
HEARTBEAT_URL_DAILY=
HEARTBEAT_URL_RESET_DEMO=
HEARTBEAT_URL_DISPOSABLE_DOMAINS=
