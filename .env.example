# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo se usa en Route Handlers (servidor). NUNCA exponerla con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dominio raíz de producción (subdominios de tenant se resuelven contra este valor en proxy.ts)
NEXT_PUBLIC_ROOT_DOMAIN=btacotiza.com

# WhatsApp de soporte de BTA (no del tenant) que se muestra en app/suspended.
# Formato E.164 sin "+" ni espacios, ej. 5215512345678. Si se deja vacío no
# se muestra el botón de contacto.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Rate limits (lib/rate-limit.ts). Sin estas variables no se limita (solo desarrollo local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protege las rutas /api/cron/*. Vercel la envía como "Authorization: Bearer <valor>".
CRON_SECRET=

# Turnstile del registro (Cloudflare). Sin site key el formulario funciona sin captcha (solo desarrollo).
# Para que también proteja los signUp directos, activa Captcha con Turnstile en Supabase Auth con el secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
